    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>PlacidWay Assistant</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Fraunces:opsz,wght@9..144,500&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --bg:#eef4f4; --panel:#ffffff; --ink:#12292d; --muted:#5b7276; --line:#d5e3e3;\n  --accent:#0b6e75; --accent-ink:#ffffff; --user:#12292d; --user-ink:#f1f7f7;\n  --chip:#e3f0f0; --err:#a43d2f;\n  --sans:'Figtree',system-ui,-apple-system,'Segoe UI',sans-serif;\n  --serif:'Fraunces',Georgia,'Times New Roman',serif;\n}\n@media (prefers-color-scheme:dark){\n  :root{ --bg:#0c1719; --panel:#122326; --ink:#e4f0f0; --muted:#8fa9ad; --line:#223a3e;\n    --accent:#4fb8bf; --accent-ink:#06191b; --user:#4fb8bf; --user-ink:#06191b; --chip:#183034; --err:#e58a7c; }\n}\n*{box-sizing:border-box}\nhtml,body{height:100%;margin:0}\nbody{background:var(--bg);color:var(--ink);font:16px/1.55 var(--sans);display:flex;justify-content:center;\n  padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom)}\n.app{width:100%;max-width:760px;height:100%;display:flex;flex-direction:column;background:var(--panel);\n  border-left:1px solid var(--line);border-right:1px solid var(--line)}\nheader{display:flex;align-items:center;gap:12px;padding:14px 20px;border-bottom:1px solid var(--line)}\n.mark{width:34px;height:34px;border-radius:50%;background:var(--accent);flex:none;position:relative}\n.mark::before,.mark::after{content:\"\";position:absolute;background:var(--accent-ink);border-radius:2px}\n.mark::before{left:15px;top:8px;width:4px;height:18px}\n.mark::after{left:8px;top:15px;width:18px;height:4px}\nheader h1{font-size:1rem;font-weight:600;margin:0;line-height:1.2}\nheader p{margin:0;font-size:.82rem;color:var(--muted)}\nheader button{margin-left:auto}\n.ghost{background:none;border:1px solid var(--line);color:var(--muted);border-radius:8px;padding:6px 12px;\n  font:inherit;font-size:.85rem;cursor:pointer}\n.ghost:hover{color:var(--ink);border-color:var(--muted)}\nmain{flex:1;overflow-y:auto;padding:24px 20px;scroll-behavior:smooth}\n.hello{padding:8vh 0 12px}\n.hello h2{font:500 clamp(1.6rem,4.5vw,2.2rem)/1.2 var(--serif);margin:0 0 10px;max-width:20ch}\n.hello p{margin:0 0 22px;color:var(--muted);max-width:52ch}\n.starters{display:flex;flex-direction:column;align-items:flex-start;gap:8px}\n.starters button{font:inherit;font-size:.95rem;text-align:left;color:var(--ink);background:var(--chip);\n  border:1px solid transparent;border-radius:12px;padding:10px 14px;cursor:pointer}\n.starters button:hover{border-color:var(--accent)}\n.msg{display:flex;margin:0 0 18px}\n.msg.user{justify-content:flex-end}\n.bubble{max-width:88%}\n.user .bubble{background:var(--user);color:var(--user-ink);padding:10px 14px;border-radius:16px 16px 4px 16px;white-space:pre-wrap}\n.bot .bubble{max-width:100%}\n.bot .text p{margin:0 0 .7em}\n.bot .text ul{margin:0 0 .7em;padding-left:1.2em}\n.bot .text li{margin:.2em 0}\n.bot .text a{color:var(--accent);text-underline-offset:2px;word-break:break-word}\n.bot .text>:last-child{margin-bottom:0}\n.sources{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;padding-top:10px;border-top:1px solid var(--line)}\n.sources span{font-size:.82rem;color:var(--muted);align-self:center;margin-right:2px}\n.sources a{font-size:.82rem;font-weight:500;color:var(--ink);text-decoration:none;background:var(--chip);\n  border-radius:999px;padding:3px 11px;border:1px solid transparent}\n.sources a:hover{border-color:var(--accent)}\n.err .text{color:var(--err)}\n.typing{display:inline-flex;gap:5px;padding:8px 0}\n.typing i{width:7px;height:7px;border-radius:50%;background:var(--muted);animation:b 1.2s infinite ease-in-out}\n.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}\n@keyframes b{0%,60%,100%{opacity:.3;transform:none}30%{opacity:1;transform:translateY(-3px)}}\n@media (prefers-reduced-motion:reduce){.typing i{animation:none;opacity:.6}main{scroll-behavior:auto}}\nfooter{padding:12px 20px 14px;border-top:1px solid var(--line)}\nform{display:flex;gap:10px;align-items:flex-end}\ntextarea{flex:1;resize:none;max-height:140px;font:inherit;color:var(--ink);background:var(--bg);\n  border:1px solid var(--line);border-radius:12px;padding:10px 14px;line-height:1.4}\ntextarea:focus{outline:2px solid var(--accent);outline-offset:1px;border-color:transparent}\n#send{background:var(--accent);color:var(--accent-ink);border:0;border-radius:12px;padding:0 18px;height:44px;\n  font:inherit;font-weight:600;cursor:pointer}\n#send:disabled{opacity:.5;cursor:not-allowed}\n#send:focus-visible,.ghost:focus-visible,.starters button:focus-visible,.sources a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}\n.note{margin:8px 2px 0;font-size:.78rem;color:var(--muted)}\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <header>\n    <div class=\"mark\" aria-hidden=\"true\"></div>\n    <div>\n      <h1>PlacidWay Assistant</h1>\n      <p>Answers come only from the ITC Immunity Therapy Center pages</p>\n    </div>\n    <button class=\"ghost\" id=\"reset\" type=\"button\">New chat</button>\n  </header>\n\n  <main id=\"log\" aria-live=\"polite\">\n    <section class=\"hello\" id=\"hello\">\n      <h2>Ask about treatments, prices and packages</h2>\n      <p>I answer from PlacidWay’s own pages on ITC in Tijuana and link the page each answer comes from. If it isn’t there, I’ll say so.</p>\n      <div class=\"starters\" id=\"starters\"></div>\n    </section>\n  </main>\n\n  <footer>\n    <form id=\"form\">\n      <textarea id=\"input\" rows=\"1\" placeholder=\"Type your question\" aria-label=\"Your question\" maxlength=\"1000\"></textarea>\n      <button id=\"send\" type=\"submit\">Send</button>\n    </form>\n    <p class=\"note\">General information only, not medical advice. Please talk to a doctor about your own case.</p>\n  </footer>\n</div>\n\n<script>\n// Leave webhookUrl empty when n8n serves this page (it posts to its own URL).\n// If you host the file elsewhere, paste your n8n production webhook URL here.\nconst CONFIG = {\n  webhookUrl: '',\n  quoteUrl: 'https://www.placidway.com/request-info',\n  starters: [\n    'How much does cancer treatment cost at ITC in Tijuana?',\n    'What is included in the adenocarcinoma treatment package?',\n    'Which cancer types are on the ITC price list?',\n    'How do I request a free quote?'\n  ]\n};\n\nconst $ = id => document.getElementById(id);\nconst log = $('log'), input = $('input'), send = $('send');\nlet busy = false;\n\nfunction newId(){ return (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random().toString(16).slice(2)); }\nlet sessionId;\ntry { sessionId = localStorage.getItem('pw-session') || newId(); localStorage.setItem('pw-session', sessionId); }\ncatch { sessionId = newId(); }\n\n// ---- rendering helpers (escape first, then add safe markup) ----\nconst esc = s => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nfunction inline(s){\n  s = esc(s);\n  s = s.replace(/\\[([^\\]]+)\\]\\((https?:\\/\\/[^\\s)]+)\\)/g, '<a href=\"$2\" target=\"_blank\" rel=\"noopener noreferrer\">$1</a>');\n  s = s.replace(/(^|[\\s(])(https?:\\/\\/[^\\s<)]*[^\\s<).,;:!?])/g, '$1<a href=\"$2\" target=\"_blank\" rel=\"noopener noreferrer\">$2</a>');\n  return s.replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1</strong>');\n}\nfunction render(text){\n  let html = '', list = false;\n  for (const line of text.split('\\n')){\n    const li = line.match(/^\\s*[-*\\u2022]\\s+(.*)/), h = line.match(/^#{1,4}\\s+(.*)/);\n    if (li){ if(!list){ html += '<ul>'; list = true; } html += '<li>' + inline(li[1]) + '</li>'; continue; }\n    if (list){ html += '</ul>'; list = false; }\n    if (h) html += '<p><strong>' + inline(h[1]) + '</strong></p>';\n    else if (line.trim()) html += '<p>' + inline(line) + '</p>';\n  }\n  return html + (list ? '</ul>' : '');\n}\nconst LABELS = { 'profile':'Clinic profile', 'package':'Treatment package', 'price-list':'Price list',\n  'profile-videos':'Clinic videos', 'search-medical-pricings':'Price comparison', 'request-info':'Free quote', 'rfi':'Free quote' };\nfunction sourcesOf(text){\n  const urls = [...new Set((text.match(/https?:\\/\\/[^\\s)\\]<>\"']+/g) || []).map(u => u.replace(/[.,;:!?]+$/, '')))];\n  return urls.slice(0, 4).map(u => {\n    try { const p = new URL(u).pathname.split('/').filter(Boolean); return { u, label: LABELS[p[0]] || new URL(u).hostname }; }\n    catch { return null; }\n  }).filter(Boolean);\n}\n\nfunction add(role, html, extra = ''){\n  const m = document.createElement('div');\n  m.className = 'msg ' + role + ' ' + extra;\n  m.innerHTML = '<div class=\"bubble\">' + html + '</div>';\n  log.appendChild(m); log.scrollTop = log.scrollHeight;\n  return m;\n}\nfunction addBot(text, isErr){\n  const src = isErr ? [] : sourcesOf(text);\n  const chips = src.length ? '<div class=\"sources\"><span>Sources</span>' +\n    src.map(s => '<a href=\"' + esc(s.u) + '\" target=\"_blank\" rel=\"noopener noreferrer\">' + esc(s.label) + '</a>').join('') + '</div>' : '';\n  return add('bot', '<div class=\"text\">' + render(text) + '</div>' + chips, isErr ? 'err' : '');\n}\n\n// ---- sending ----\nasync function ask(text){\n  text = text.trim(); if (!text || busy) return;\n  busy = true; send.disabled = true;\n  $('hello')?.remove();\n  add('user', esc(text));\n  const wait = add('bot', '<div class=\"typing\" aria-label=\"Assistant is typing\"><i></i><i></i><i></i></div>');\n  const ctrl = new AbortController(), timer = setTimeout(() => ctrl.abort(), 60000);\n  try {\n    const res = await fetch(CONFIG.webhookUrl || location.href.split(/[?#]/)[0], {\n      method: 'POST', headers: { 'Content-Type': 'application/json' }, signal: ctrl.signal,\n      body: JSON.stringify({ action: 'sendMessage', sessionId, chatInput: text })\n    });\n    if (!res.ok) throw new Error('HTTP ' + res.status);\n    const raw = await res.text(); let data;\n    try { data = JSON.parse(raw); } catch { data = { output: raw }; }\n    if (Array.isArray(data)) data = data[0] || {};\n    const reply = data.output ?? data.text ?? data.message;\n    if (!reply) throw new Error('Empty reply');\n    wait.remove(); addBot(String(reply));\n  } catch (e) {\n    wait.remove();\n    addBot('The assistant could not answer just now. Please try again in a moment, or request a free quote at ' + CONFIG.quoteUrl, true);\n    console.error(e);\n  } finally { clearTimeout(timer); busy = false; send.disabled = false; input.focus(); }\n}\n\n$('form').addEventListener('submit', e => { e.preventDefault(); const t = input.value; input.value = ''; fit(); ask(t); });\ninput.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); $('form').requestSubmit(); } });\nfunction fit(){ input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 140) + 'px'; }\ninput.addEventListener('input', fit);\n\nCONFIG.starters.forEach(q => {\n  const b = document.createElement('button'); b.type = 'button'; b.textContent = q;\n  b.addEventListener('click', () => ask(q)); $('starters').appendChild(b);\n});\n$('reset').addEventListener('click', () => {\n  sessionId = newId();\n  try { localStorage.setItem('pw-session', sessionId); } catch {}\n  location.reload();\n});\n</script>\n</body>\n</html>\n",
